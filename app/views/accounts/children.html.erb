<p style="color: green"><%= notice %></p>
<h1>Children for Account <%= @account.id %></h1>

<ul>
  <% @children.each do |child| %>
    <li>
      <%= link_to child.name, account_child_path(@account, child) %>
      <%= button_to "Delete", child, method: :delete, form: { style: "display:inline;", data: { turbo: false } } %>
    </li>
  <% end %>
</ul>

<div style="margin-bottom: 20px;">
  <%= link_to "Add New Child", new_account_child_path(@account), class: "button" %>
</div>


<%= link_to "Back to Account", account_path(@account) %>
