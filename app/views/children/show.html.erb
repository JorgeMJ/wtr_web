<p style="color: green"><%= notice %></p>

<h1><%= @child.name %></h1>

<%= render @child %>

<section style="margin-top: 1.5rem;">
  <h2>Add a word</h2>
  <%= form_with(model: @word, url: words_path, local: true) do |form| %>
    <div>
      <%= form.label :word, "Word" %><br>
      <%= form.text_field :word %>
    </div>
    <%= form.hidden_field :child_id, value: @child.id %>
    <div>
      <%= form.label :date, "Time" %><br>
      <%= form.date_select :date %>
    </div>
    <div style="margin-top: 0.5rem;">
      <%= form.label :sign, "Sign" %><br>
      <%= form.check_box :sign %>
    </div>
    <div style="margin-top: 0.5rem;">
      <%= form.submit "Add Word" %>
    </div>
  <% end %>
</section>

<section style="margin-top: 1.5rem;">
  <% if @child.words.any? %>
    <table>
      <thead>
        <tr>
          <th>Word</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @child.words.each do |word| %>
          <tr>
            <td><%= word.word %></td>
            <td><%= word.date %></td>
            <td><%= button_to "Delete", word, method: :delete, form: { data: { turbo: false } } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No words added yet.</p>
  <% end %>
</section>

<div>
  <%# <%= link_to "Edit this child", edit_child_path(@child) | %>
  <%= link_to "Back to children", account_children_path(@account) %>
</div>
