<% form_model = defined?(@account) && @account.present? ? [@account, child] : child %>
<%= form_with(model: form_model, local: true) do |form| %>


   <h3>Child Information</h3>

     <div>
    <%= form.label :name, "Child Name" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
