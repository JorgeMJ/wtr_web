<%= form_with(model: account, local: true) do |f| %>

  <h3>Parent Information</h3>

  <div>
    <%= f.label :parent_name, "Parent Name" %>
    <%= f.text_field :parent_name %>
  </div>

  <div>
    <%= f.label :parent_email, "Parent Email" %>
    <%= f.email_field :parent_email %>
  </div>

  <div>
    <%= f.submit "Create Account" %>
  </div>

<% end %>

