
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Main</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>

<body>

  <h1>Welcome</h1>

  <!-- Basic Sign-in Form -->
  <div>
    <h2>Sign In</h2>

    <%= form_with url: "/signin", method: :post, local: true do |f| %>
      <div>
        <label for="name">Name</label>
        <%= f.text_field :name, id: "name" %>
      </div>

      <div>
        <label for="email">Email</label>
        <%= f.email_field :email, id: "email" %>
      </div>

      <div>
        <%= f.submit "Sign In" %>
      </div>
    <% end %>
  </div>
  <hr>
  <p>Don't have an account? Create one now!</p>

  <!-- Create Account Button -->
  <div style="margin-top: 20px;">
    <%= link_to "Create Account", new_account_path, class: "button" %>
  </div>

  <%= yield %>

</body>
</html>
