
<%= render @account %>

<%= button_to "Log out", sign_out_path, method: :delete %>
<hr>

<div>
  <%= link_to "Edit this account", edit_account_path(@account) %>

  <%= button_to "Destroy this account", @account, method: :delete %>
</div>

<div>
  <%= link_to "Children List", children_account_path(@account), class: "button"%> |
  <%= link_to "Custodians List", custodians_account_path(@account), class: "button" %>
</div>
